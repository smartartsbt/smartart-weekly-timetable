#. Plugin Name of the plugin
#: smartart-weekly-timetable.php
msgid "Smartart Weekly Timetable"
msgstr "Smartart Heti Órarend"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: smartart-weekly-timetable.php
msgid "https://smartart.hu"
msgstr "https://smartart.hu"

#. Description of the plugin
#: smartart-weekly-timetable.php
msgid "Show a responsive, color-coded weekly timetable (classes, shifts, appointments) from a published Google Sheet with a simple shortcode."
msgstr "Reszponzív, színkódolt heti órarend (edzések, műszakok, időpontok) megjelenítése közzétett Google Táblázatból, egyetlen egyszerű shortcode-dal."

#. Author of the plugin
#: smartart-weekly-timetable.php
msgid "Smartart"
msgstr "Smartart"

#: includes/class-smartart-wt-plugin.php:75
msgid "Smartart Weekly Timetable: please add the url attribute to the shortcode."
msgstr "Smartart Heti Órarend: kérjük, adja meg az url paramétert a shortcode-ban."

#: includes/class-smartart-wt-plugin.php:80
msgid "Smartart Weekly Timetable: the URL must be a Google Sheets link published to the web as CSV."
msgstr "Smartart Heti Órarend: az URL-nek CSV formátumban közzétett Google Táblázat-hivatkozásnak kell lennie."

#: includes/class-smartart-wt-plugin.php:104
msgid "The timetable is currently unavailable."
msgstr "Az órarend jelenleg nem érhető el."

#: includes/class-smartart-wt-renderer.php:150
msgid "Weekly timetable"
msgstr "Heti órarend"

#: includes/class-smartart-wt-renderer.php:151
msgid "Time"
msgstr "Idő"

#: includes/class-smartart-wt-renderer.php:206
msgid "No classes on this day."
msgstr "Ezen a napon nincs óra."

#: includes/class-smartart-wt-source.php:138
msgid "The timetable source could not be reached."
msgstr "Az órarend forrása nem érhető el."

#: includes/class-smartart-wt-source.php:142
msgid "The timetable source returned an error. Check that the sheet is published to the web as CSV."
msgstr "Az órarend forrása hibát jelzett. Ellenőrizze, hogy a táblázat CSV formátumban van-e közzétéve az interneten."

#: includes/class-smartart-wt-source.php:148
msgid "The timetable source is too large."
msgstr "Az órarend forrása túl nagy."

#: includes/class-smartart-wt-source.php:153
msgid "The published sheet did not return CSV data. Publish the sheet again with the CSV format."
msgstr "A közzétett táblázat nem CSV adatot adott vissza. Tegye közzé újra a táblázatot CSV formátumban."

#: includes/class-smartart-wt-source.php:232
msgid "The sheet does not match the expected timetable layout."
msgstr "A táblázat nem felel meg a várt órarend-elrendezésnek."
